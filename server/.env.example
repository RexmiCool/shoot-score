# Clé secrète pour l'authentification Bearer token
# IMPORTANT: Changez cette valeur en production avec une clé très sécurisée
API_SECRET_TOKEN=your-very-secure-random-token-here-min-32-chars

# Répertoire de stockage des uploads (utilisé par Docker)
UPLOAD_DIR=/app/data/uploads

# Chemin de la base de données SQLite (utilisé par Docker)
DB_PATH=/app/db/shootscore.db
